import cv2
import numpy as np
import matplotlib.pyplot as plt

# Define the image path
image_path = '/content/nature.jpg'

# Load the image
original_image = cv2.imread(image_path)

# Check if image was loaded successfully
if original_image is None:
    print(f"Error: Could not load image from {image_path}")
else:
    # Convert image to float32 for noise addition
    img_float = original_image.astype(np.float32) / 255.0  # Normalize to [0, 1]

    # Generate Gaussian noise
    mean = 0
    std_dev = 0.1  # Standard deviation of the noise
    noise = np.random.normal(mean, std_dev, img_float.shape).astype(np.float32)

    # Add noise to the image
    noisy_image_float = img_float + noise

    # Clip values to stay within [0, 1] and convert back to uint8
    noisy_image = np.clip(noisy_image_float, 0, 1) * 255
    noisy_image = noisy_image.astype(np.uint8)

    # Convert images from BGR to RGB for displaying with matplotlib
    original_image_rgb = cv2.cvtColor(original_image, cv2.COLOR_BGR2RGB)
    noisy_image_rgb = cv2.cvtColor(noisy_image, cv2.COLOR_BGR2RGB)

    # Display the original and noisy images
    plt.figure(figsize=(12, 6))

    plt.subplot(1, 2, 1)
    plt.imshow(original_image_rgb)
    plt.title('Original Image')
    plt.axis('off')

    plt.subplot(1, 2, 2)
    plt.imshow(noisy_image_rgb)
    plt.title('Image with Gaussian Noise')
    plt.axis('off')

    plt.show()
